# Copy to .env.local and fill in values from the Supabase project settings.
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Optional Dashboard “Publishable key” alias (used if ANON_KEY is unset):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional internal job secret:
# INTERNAL_API_SECRET=

# Optional legacy alias (still read by getAppUrl() if APP_URL is unset):
# NEXT_PUBLIC_APP_URL=http://localhost:3000
