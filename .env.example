# Copy to .env.local and fill in values from the Supabase project settings.
# Never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=
# Prefer the Dashboard “Publishable key”:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias (still accepted if PUBLISHABLE_KEY is unset):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# Optional legacy alias (still read by getAppUrl() if APP_URL is unset):
# NEXT_PUBLIC_APP_URL=http://localhost:3000
