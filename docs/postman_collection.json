{
  "info": {
    "name": "OAMK Matching Tool API",
    "description": "Projects-model smoke collection. Set collection variables after signing in via Supabase Auth. Legacy /api/opportunities returns 410 — use /api/projects.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "projectId", "value": "90000000-0000-4000-8000-000000000001" },
    { "key": "applicationId", "value": "" },
    { "key": "notificationId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Health (no auth)",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Me",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/me"
      }
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"degreeProgramme\": \"Tietotekniikka\",\n  \"department\": \"ICT\",\n  \"studyCredits\": 120,\n  \"availabilityStart\": \"2026-09-01\",\n  \"availabilityEnd\": \"2026-12-15\",\n  \"preferredProjectTypes\": [\"company_project\", \"internship\"]\n}"
            },
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Get student",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        },
        {
          "name": "Update student",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studyCredits\": 130\n}"
            },
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "List published projects",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects?status=published"
          }
        },
        {
          "name": "Create project",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Campus portal renewal\",\n  \"description\": \"Rebuild student-facing portal UI.\",\n  \"projectType\": \"company_project\",\n  \"status\": \"published\",\n  \"positions\": 2,\n  \"requiredLanguage\": \"fi\",\n  \"minimumStudyCredits\": 60,\n  \"weights\": {\n    \"studyCredits\": 10,\n    \"requiredCourses\": 20,\n    \"recommendedCourses\": 10,\n    \"skills\": 25,\n    \"language\": 10,\n    \"availability\": 10,\n    \"interests\": 10,\n    \"degreeProgramme\": 5\n  }\n}"
            },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "Get project",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}"
          }
        },
        {
          "name": "List applicants",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/applicants"
          }
        },
        {
          "name": "Top candidates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/top-candidates?limit=3"
          }
        },
        {
          "name": "Run project matching",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/matches"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "Create application",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{projectId}}\",\n  \"message\": \"I am interested in this project.\"\n}"
            },
            "url": "{{baseUrl}}/api/applications"
          }
        },
        {
          "name": "My applications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/applications/me"
          }
        },
        {
          "name": "Shortlist application",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/shortlist"
          }
        },
        {
          "name": "Withdraw application",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/applications/{{applicationId}}/withdraw"
          }
        }
      ]
    },
    {
      "name": "Matching",
      "item": [
        {
          "name": "Run matching (own / staff)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locale\": \"fi\"\n}"
            },
            "url": "{{baseUrl}}/api/matches/run"
          }
        },
        {
          "name": "My matches (student-safe)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/matches/me?limit=3"
          }
        },
        {
          "name": "Run matching for studentId (staff)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"locale\": \"fi\"\n}"
            },
            "url": "{{baseUrl}}/api/matches/run/{{studentId}}"
          }
        }
      ]
    },
    {
      "name": "Selections",
      "item": [
        {
          "name": "Create selection decision",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"applicationId\": \"{{applicationId}}\",\n  \"decision\": \"selected\",\n  \"note\": \"Strong React fit\"\n}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/selections"
          }
        },
        {
          "name": "List project selections",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/projects/{{projectId}}/selections"
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "List notifications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/notifications"
          }
        },
        {
          "name": "Mark notification read",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/notifications/{{notificationId}}"
          }
        },
        {
          "name": "Mark all read",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/notifications/read-all"
          }
        }
      ]
    },
    {
      "name": "Audit (teacher/admin)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/audit"
      }
    },
    {
      "name": "Legacy opportunities (expect 410)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/opportunities"
      }
    }
  ]
}
