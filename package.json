{
  "name": "oamk-matching-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "node scripts/seed-test-data.mjs && vitest run --config vitest.config.mts test/integration",
    "test:seed": "node scripts/seed-test-data.mjs",
    "test:seed:reset": "node scripts/seed-test-data.mjs --reset",
    "test:cloud-users": "node scripts/seed-cloud-manual-test-users.mjs",
    "test:cloud-users:reset": "node scripts/seed-cloud-manual-test-users.mjs --reset",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:smoke": "playwright test test/e2e/role-journeys.spec.ts",
    "test:all": "npm run verify && npm run test:integration && npm run test:e2e",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && vitest run",
    "gen:types": "node scripts/gen-database-types.mjs",
    "smoke": "node --env-file=.env.local scripts/api-smoke.mjs",
    "smoke:student": "node --env-file=.env.local scripts/flow-student.mjs",
    "smoke:company": "node --env-file=.env.local scripts/flow-company.mjs",
    "smoke:teacher": "node --env-file=.env.local scripts/flow-teacher.mjs",
    "smoke:flows": "node --env-file=.env.local scripts/flow-all.mjs",
    "smoke:security": "node --env-file=.env.local scripts/security-probe.mjs",
    "demo:dry-run": "node --env-file=.env.local scripts/demo-dry-run.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.112.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
